          },
          "text": {
            "type": "string"
          },
          "choiceId": {
            "type": [
              "string",
              "null"
            ]
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CampaignChoice"
            }
          }
        },
        "required": [
          "sceneId",
          "source",
          "text",
          "choiceId",
          "options"
        ],
        "additionalProperties": false
      },
      "CampaignContext": {
        "type": "object",
        "properties": {
          "campaignId": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "phase": {
            "type": "string"
          },
          "sharedContext": {
            "type": "string"
          },
          "discoveries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "UNKNOWN",
                    "SUSPECTED",
                    "EVIDENCE",
                    "CONFIRMED"
                  ]
                },
                "statement": {
                  "type": "string"
                },
                "evidenceEventIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "id",
                "state",
                "statement",
                "evidenceEventIds"
              ],
              "additionalProperties": false
            }
          },
          "pendingScenes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CampaignScene"
            }
          },
          "lastEventCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
