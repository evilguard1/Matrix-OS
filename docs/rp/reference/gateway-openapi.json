        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "retryable",
          "requestId"
        ],
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "properties": {
          "connected": {
            "type": "boolean"
          },
          "gameVersion": {
            "type": [
              "string",
              "null"
            ]
          },
          "releaseSha": {
            "type": [
              "string",
              "null"
            ]
          },
          "sessionId": {
            "type": "string"
          },
          "lastObservedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "protocolVersion": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "connected",
          "gameVersion",
          "releaseSha",
          "sessionId",
          "lastObservedAt",
          "protocolVersion"
        ],
        "additionalProperties": false
      },
      "Service": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "locked",
              "unimplemented",
              "not-installed",
              "ram-blocked",
              "starting",
              "running",
              "draining",
              "paused",
              "stale",
              "failed"
            ]
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "state",
          "observedAt",
          "reason"
        ],
        "additionalProperties": false
      },
      "SourceFile": {
        "type": "object",
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15
          },
          "level": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "number",
          "level"
        ],
        "additionalProperties": false
      },
      "Snapshot": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "const": 1
          },
          "snapshotId": {
            "type": "string"
          },
          "sessionId": {
            "type": "string"
          },
          "resetEpoch": {
            "type": "string"
          },
          "runtimeEpoch": {
            "type": "string"
          },
          "seq": {
            "type": "integer",
            "minimum": 0
          },
          "capturedAt": {
            "type": "string",
            "format": "date-time"
          },
          "fresh": {
            "type": "boolean"
          },
          "gameVersion": {
            "type": "string"
          },
          "releaseSha": {
            "type": "string"
          },
          "policyRevision": {
            "type": "integer",
            "minimum": 1
          },
          "bitNode": {
            "type": [
              "integer",
              "null"
            ]
          },
          "cash": {
            "type": [
              "number",
              "null"
            ]
          },
          "homeRamGb": {
            "type": [
              "number",
              "null"
            ]
          },
          "sourceFiles": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/SourceFile"
            }
          },
          "controlState": {
            "type": "string",
            "enum": [
              "RUNNING",
              "DRAINING",
              "PAUSED",
              "RECOVERY"
            ]
          },
          "services": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Service"
            }
          },
          "unavailableFields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "schemaVersion",
          "snapshotId",
          "sessionId",
          "resetEpoch",
          "runtimeEpoch",
          "seq",
          "capturedAt",
          "fresh",
          "gameVersion",
          "releaseSha",
          "policyRevision",
          "bitNode",
          "cash",
          "homeRamGb",
          "sourceFiles",
          "controlState",
          "services",
          "unavailableFields"
        ],
        "additionalProperties": false
      },
      "Event": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "seq": {
            "type": "integer",
            "minimum": 0
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "string",
            "enum": [
              "game",
              "campaign",
              "player-decision",
              "hypothesis"
            ]
          },
          "type": {
            "type": "string"
          },
          "resetEpoch": {
            "type": [
              "string",
              "null"
            ]
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "id",
          "seq",
          "occurredAt",
          "source",
          "type",
          "resetEpoch",
          "data"
        ],
        "additionalProperties": false
      },
      "EventsPage": {
        "type": "object",
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "hasMore": {
            "type": "boolean"
          }
        },
        "required": [
          "events",
          "nextCursor",
          "hasMore"
        ],
        "additionalProperties": false
      },
      "CampaignChoice": {
        "type": "object",
        "properties": {
          "optionId": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "consequenceSummary": {
            "type": "string"
          }
        },
        "required": [
          "optionId",
          "label",
          "consequenceSummary"
        ],
        "additionalProperties": false
      },
      "CampaignScene": {
        "type": "object",
        "properties": {
          "sceneId": {
            "type": "string"
          },
          "source": {
            "type": "string",
